---
// Gabarit commun de toutes les pages : en-tête, pied de page, aperçu des liens (Facebook, WhatsApp), pixel Meta.
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/zti.css';
import '../styles/retouches.css';
import EnTete from '../components/EnTete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import SuivezNous from '../components/SuivezNous.astro';
import { reglages, lien } from '../lib/contenu';
// polices du haut de page (titres Montserrat 800, texte Inter 400) : préchargées pour que le texte s'affiche plus tôt
import policeTitres from '@fontsource/montserrat/files/montserrat-latin-800-normal.woff2?url';
import policeTexte from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

// sansReseaux : sans la section « ZTi sur les réseaux sociaux » (page Merci : seule la communauté WhatsApp y est proposée)
// enteteSimple : barre du haut avec le logo seul, sans menu ni bouton (page Merci) ; le pied de page ne change pas
// titreGoogle : titre affiché dans les résultats de recherche (balise <title>), s'il diffère du titre de la page
// service : données de la fiche « Service » (données structurées) de la page, si elle présente une offre
interface Props { titre: string; description?: string; image?: string; sansMenu?: boolean; indexer?: boolean; sansReseaux?: boolean; enteteSimple?: boolean;
  titreGoogle?: string; service?: { nom?: string; description?: string; zone?: string; offre?: string } }
const { titre, description, image, sansMenu = false, indexer = true, sansReseaux = false, enteteSimple = false, titreGoogle, service } = Astro.props;
const r = await reglages();
const titreComplet = titre === r.nom ? `${r.nom} — ${r.slogan}` : `${titre} — ${r.nom}`;
const desc = description || r.description;
const adresse = new URL(Astro.url.pathname, Astro.site).href;
// aperçu de test (toute branche autre que « source » construite par Cloudflare) : jamais indexé par les moteurs
const brancheApercu = !!process.env.CF_PAGES_BRANCH && process.env.CF_PAGES_BRANCH !== 'source';
// données structurées (schema.org) : uniquement des informations vraies et visibles sur le site ;
// ni téléphone ni WhatsApp (ZTi ne les montre qu'après l'envoi du formulaire)
const accueil = new URL(lien('/'), Astro.site).href;
const idOrg = accueil + '#organisation';
const reseaux = (r.reseaux || []).map((x: any) => (x.adresse || '').trim()).filter((u: string) => /^https:\/\//.test(u));
const chemin = Astro.url.pathname;
const ariane = chemin === lien('/') ? [] : [
  { nom: 'Accueil', url: accueil },
  ...(chemin.startsWith(lien('/services/')) && chemin !== lien('/services/') ? [{ nom: 'Nos services', url: new URL(lien('/services/'), Astro.site).href }] : []),
  { nom: titre, url: adresse },
];
// téléphones (réglages) : appels au +237 676 165 772, WhatsApp au +237 699 324 689 (choix de ZTi du 11/11)
const intl = (x?: string) => { const c = (x || '').replace(/\D/g, ''); return c ? '+' + (c.startsWith('237') ? c : '237' + c) : ''; };
const telAppel = intl(r.contact?.telephone), telWa = intl(r.contact?.whatsapp);
const contacts = [
  telAppel && { '@type': 'ContactPoint', contactType: 'customer service', name: 'Appels', telephone: telAppel, areaServed: 'CM', availableLanguage: 'French' },
  telWa && { '@type': 'ContactPoint', contactType: 'customer service', name: 'WhatsApp', telephone: telWa, url: `https://wa.me/${telWa.slice(1)}`, areaServed: 'CM', availableLanguage: 'French' },
].filter(Boolean);
const donnees = [
  { '@context': 'https://schema.org', '@type': 'Organization', '@id': idOrg, name: r.nom, legalName: r.nom_legal, url: accueil,
    logo: new URL(lien('/images/logo-bleu.png'), Astro.site).href,
    // image de la fiche Google (choix de ZTi du 11/11) : paysage 16:9 et carré
    image: ['/images/zti-intervention-ecole.jpg', '/images/zti-intervention-ecole-carre.jpg'].map(i => new URL(lien(i), Astro.site).href),
    slogan: r.slogan, foundingDate: r.depuis, email: r.contact?.email,
    ...(telAppel ? { telephone: telAppel } : {}), ...(contacts.length ? { contactPoint: contacts } : {}),
    address: { '@type': 'PostalAddress', ...(r.contact?.quartier ? { streetAddress: r.contact.quartier } : {}), addressLocality: 'Yaoundé', addressCountry: 'CM' }, ...(reseaux.length ? { sameAs: reseaux } : {}) },
  ...(ariane.length ? [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: ariane.map((a, i) => ({ '@type': 'ListItem', position: i + 1, name: a.nom, item: a.url })) }] : []),
  ...(service?.nom ? [{ '@context': 'https://schema.org', '@type': 'Service', name: service.nom, description: service.description || desc,
    url: adresse, provider: { '@id': idOrg }, ...(service.zone ? { areaServed: { '@type': 'City', name: service.zone } } : {}),
    ...(service.offre ? { offers: { '@type': 'Offer', price: '0', priceCurrency: 'XAF', description: service.offre } } : {}) }] : []),
];
const json = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c');
const apercu = new URL(lien(image || '/images/partage.jpg'), Astro.site).href;
const pixel = (r.mesures?.pixel || '').trim();
const serveur = (r.mesures?.endpoint || '').trim().replace(/\/$/, '');
---
<!doctype html>
<html lang="fr" class="sans-js" data-serveur={serveur}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{titreGoogle || titreComplet}</title>
  <meta name="description" content={desc}>
  {(!indexer || brancheApercu) && <meta name="robots" content="noindex">}
  <link rel="preload" href={policeTitres} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={policeTexte} as="font" type="font/woff2" crossorigin>
  <link rel="canonical" href={adresse}>
  <!-- Google Search Console (compte ZTI Professionnels) : preuve que le site appartient à ZTi -->
  <meta name="google-site-verification" content="5x34oN6nhbxyYtEaWhQZZxqu8bFXz5u6smiVIct40nU">
  <link rel="icon" href={lien('/favicon.ico')} sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href={lien('/favicon-32.png')}>
  <link rel="apple-touch-icon" href={lien('/apple-touch-icon.png')}>
  <link rel="manifest" href={lien('/site.webmanifest')}>
  <meta name="theme-color" content="#010038">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content={r.nom}>
  <meta property="og:title" content={titreComplet}>
  <meta property="og:description" content={desc}>
  <meta property="og:url" content={adresse}>
  <meta property="og:image" content={apercu}>
  <meta name="twitter:card" content="summary_large_image">
  {indexer && donnees.map(d => <script type="application/ld+json" set:html={json(d)} />)}
  <script is:inline>document.documentElement.classList.remove('sans-js');</script>
  {pixel && (
    <script is:inline define:vars={{ pixel }}>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', pixel); fbq('track', 'PageView');
    </script>
  )}
</head>
<body>
  <a class="visuellement-cache" href="#contenu">Aller au contenu</a>
  <EnTete sansMenu={sansMenu || enteteSimple} sansBouton={enteteSimple} />
  <main id="contenu"><slot /></main>
  {!sansReseaux && <SuivezNous />}
  <PiedDePage sansMenu={sansMenu} />
  <script>import '../scripts/site.js';</script>
</body>
</html>
