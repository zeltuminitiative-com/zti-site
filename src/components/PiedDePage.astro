---
import Icone from './Icone.astro';
import { reglages, services, lien, iconeReseau, lienSur } from '../lib/contenu';
const { sansMenu = false } = Astro.props as { sansMenu?: boolean };
const r = await reglages();
const liste = await services();
const reseaux = (r.reseaux || []).map(x => ({ ...x, adresse: lienSur(x.adresse) })).filter(x => x.nom && x.adresse);
// icônes « Suivez ZTi » : les réseaux des réglages, puis WhatsApp
const icone = (nom: string) => iconeReseau(nom) as any;
const suivre = [
  ...reseaux.map(x => ({ nom: x.nom, adresse: x.adresse, icone: icone(x.nom) })),
  // WhatsApp : la communauté « Parlons de vos problèmes IT » si elle existe, sinon la discussion avec ZTi
  ...(!reseaux.some(x => icone(x.nom) === 'whatsapp') && (lienSur(r.communaute?.whatsapp) || r.contact.whatsapp)
    ? [{ nom: lienSur(r.communaute?.whatsapp) ? 'Communauté WhatsApp' : 'WhatsApp', adresse: lienSur(r.communaute?.whatsapp) || `https://wa.me/${r.contact.whatsapp.replace(/\D/g, '')}`, icone: 'whatsapp' as any }] : []),
];
const annee = new Date().getFullYear();
const serveur = (r.mesures?.endpoint || '').trim().replace(/\/$/, '');
// Support : numéros WhatsApp et appels affichés à titre d'information, SANS lien (choix de ZTi du 11/11 : le contact passe par le formulaire),
// puis les horaires sur deux lignes (séparées par « · » dans les réglages)
const numero = (x?: string) => { const c = (x || '').replace(/\D/g, ''); const n = c.startsWith('237') ? c : '237' + c; return n.length === 12 ? n.replace(/(\d{3})(\d{3})(\d{3})(\d{3})/, '+$1 $2 $3 $4') : ''; };
const numeroWa = numero(r.contact.whatsapp), numeroAppel = numero(r.contact.telephone);
const horaires = (r.contact.horaires || '').split(' · ').map(h => h.trim().replace(/\.$/, '').replace(/(\d) (?=[hj]\b)/g, '$1 ')).filter(Boolean);
---
<footer class="pied">
  <div class="contenu">
    <div class="colonnes">
      <div class="marque">
        <a href={lien('/')} class="pied-logo" aria-label={`${r.nom} : page d'accueil`}><img src={lien('/images/logo-blanc.png')} alt={r.nom} width="68" height="44" loading="lazy"></a>
        <p>{r.signature}<br>Depuis {r.depuis}</p>
        <p>« {r.slogan} »</p>
        {suivre.length > 0 && (
          <div class="suivre">
            <span>Suivez ZTi</span>
            <ul>{suivre.map(x => <li><a href={x.adresse} rel="noopener" target="_blank" aria-label={`ZTi sur ${x.nom}`}><Icone nom={x.icone} /></a></li>)}</ul>
          </div>
        )}
      </div>
      <div>
        <h4>Nos services</h4>
        <ul>{liste.map(s => <li><a href={lien(`/services/${s.id}/`)}>{s.data.titre}</a></li>)}</ul>
      </div>
      <div>
        <h4>ZTi</h4>
        <ul>
          {sansMenu && <li><a href={lien('/')}>Découvrir ZTi</a></li>}
          <li><a href={lien('/engagements/')}>Travailler avec ZTi</a></li>
          <li><a href={lien('/#avis')}>Donner votre avis</a></li>
          <li><a href={lien('/telechargements/')}>Téléchargements</a></li>
          {serveur && <li><a href={serveur + '/espace/'}>Espace ambassadeurs</a></li>}
        </ul>
      </div>
      <div>
        <h4>Support</h4>
        <ul>
          {numeroWa && <li class="pied-numero"><Icone nom="whatsapp" /><span><span class="masque">WhatsApp : </span>{numeroWa}</span></li>}
          {numeroAppel && <li class="pied-numero"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg><span><span class="masque">Appels : </span>{numeroAppel}</span></li>}
          {r.contact.email && <li class="pied-numero"><Icone nom="mail" /><a href={`mailto:${r.contact.email}`}>{r.contact.email}</a></li>}
          {horaires.map(h => { const [debut, suite] = h.split(/(?<=reçus) |, (?=de \d)/); return <li>{debut}{suite && <><br />{suite}</>}</li>; })}
          {r.contact.adresse && <li>{[r.contact.quartier, r.contact.adresse].filter(Boolean).join(', ')}</li>}
        </ul>
        <a class="btn pied-contact" href={lien('/contact/')}>Écrire à ZTi<span class="pastille"><Icone nom="fleche" /></span></a>
      </div>
    </div>
    <div class="geant" aria-hidden="true" style={`--logo-zti: url(${lien('/images/logo-zti.svg')})`}></div>
    <div class="bas">
      <span>© {annee} {r.nom_legal}. Tous droits réservés.</span>
      <a href={lien('/confidentialite/')}>Informations légales</a>
    </div>
  </div>
</footer>
