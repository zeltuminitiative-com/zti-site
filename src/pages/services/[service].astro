---
import Base from '../../layouts/Base.astro';
import Bouton from '../../components/Bouton.astro';
import Icone from '../../components/Icone.astro';
import Demande from '../../components/sections/Demande.astro';
import Sections from '../../components/Sections.astro';
import { getCollection, render } from 'astro:content';
import { lien, PUBLICS } from '../../lib/contenu';
export async function getStaticPaths() {
  const liste = await getCollection('services', s => s.data.en_ligne);
  return liste.map(s => ({ params: { service: s.id }, props: { s } }));
}
const { s } = Astro.props;
const d = s.data;
const { Content } = await render(s);
const campagnes = await getCollection('campagnes', c => c.data.en_ligne);
const offre = d.campagne ? (campagnes.find(c => c.id === d.campagne) ? `/offres/${d.campagne}/` : d.campagne) : '';
// si la première section est une accroche (ex. plein écran comme la page école), elle remplace l'en-tête standard du service
const heroPropre = d.sections[0]?.type === 'accroche';
const suite = heroPropre ? d.sections.slice(1) : d.sections;
---
<Base titre={d.titre} description={d.accroche || d.resume}>
  {heroPropre ? <Sections sections={[d.sections[0]]} page={`services/${s.id}`} /> :
  <section class={`section accroche fond-nuit sombre ${d.image ? '' : 'sans-image'}`}>
    <div class="contenu">
      <div class="grille">
        <div>
          <p class="fil"><a href={lien('/#services')}>Nos services</a> › {d.titre}</p>
          {d.publics.length > 0 && <ul class="publics-tags">{d.publics.map(p => <li>{PUBLICS[p] || p}</li>)}</ul>}
          <h1>{d.titre}</h1>
          {d.accroche && <p class="chapo">{d.accroche}</p>}
          <div class="actions">
            <Bouton texte="Demander un diagnostic" href="#demande" />
            {offre && <a class="lien" href={lien(offre)}>Voir l'offre complète<Icone nom="fleche" /></a>}
          </div>
        </div>
        {d.image && <div class="visuel"><img src={lien(d.image)} alt="" fetchpriority="high"></div>}
      </div>
    </div>
  </section>}
  <section class="section fond-blanc">
    <div class="contenu etroit">
      {d.intro_titre && <div class="rv" style="margin-bottom:28px">{d.intro_etiquette && <span class="etiquette">{d.intro_etiquette}</span>}<h2>{d.intro_titre}</h2></div>}
      {d.points.length > 0 && <ul class="liste-coches rv" style="margin-bottom:32px">{d.points.map(p => <li>{p}</li>)}</ul>}
      <div class="texte-riche rv"><Content /></div>
    </div>
  </section>
  <!-- sections facultatives du service (mêmes blocs que les pages), avant le formulaire -->
  {suite.length > 0 && <Sections sections={suite} page={`services/${s.id}`} debut={heroPropre ? 1 : 0} />}
  {d.formulaire && <Demande s={{ titre: d.formulaire_titre || 'Parlons de votre besoin.', texte: d.formulaire_texte || 'ZTi vous recontacte au moment choisi.', sujet: d.titre, besoins: [d.titre] }} page={`services/${s.id}`} campagne="" />}
</Base>
