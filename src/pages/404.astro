---
import Base from '../layouts/Base.astro';
import Bouton from '../components/Bouton.astro';
import { lien } from '../lib/contenu';
---
<Base titre="Page introuvable" indexer={false}>
  <!-- page d'erreur : fond blanc, texte à gauche et image animée à droite (dessous sur téléphone) — demande de ZTi du 11/11 -->
  <section class="section fond-blanc page-simple erreur-404">
    <div class="contenu">
      <div class="grille-404">
        <div class="texte-404 rv">
          <span class="etiquette">Erreur 404</span>
          <h1>Cette page n'existe pas ou a changé d'adresse.</h1>
          <p class="chapo">Les services et les offres de ZTi sont toujours là.</p>
          <div class="actions"><Bouton texte="Retour à l'accueil" href="/" /><a class="lien" href={lien('/services/')}>Nos services</a><a class="lien" href={lien('/contact/')}>Écrire à ZTi</a></div>
        </div>
        <img class="image-404 rv" src={lien('/images/zti-page-erreur-404.gif')} alt="Illustration : intérieur d'un appareil en cours de mise à jour, un technicien travaille sur son ordinateur portable" width="730" height="800">
      </div>
    </div>
  </section>
</Base>

<style>
  .erreur-404 { background: #FFFFFF; padding-top: 40px; padding-bottom: 40px; }
  .grille-404 { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; }
  /* image entière dès l'ouverture : sa hauteur ne dépasse pas l'espace visible sous la barre du haut */
  .image-404 { width: auto; max-width: 100%; height: auto; max-height: min(560px, calc(100svh - 150px)); justify-self: center; }
  /* apparition en cascade, comme les autres pages : étiquette, titre, phrase, boutons, puis l'image */
  .texte-404.vu > * { animation: d-monte .7s cubic-bezier(.2,.7,.2,1) both; }
  .texte-404.vu > :nth-child(2) { animation-delay: .12s; } .texte-404.vu > :nth-child(3) { animation-delay: .24s; } .texte-404.vu > :nth-child(4) { animation-delay: .36s; }
  .image-404.vu { animation: d-fondu 1s .3s both; }
  @media (prefers-reduced-motion: reduce) { .texte-404.vu > *, .image-404.vu { animation: none; } }
  .texte-404 h1 { font-size: clamp(30px, 3.6vw, 46px); }   /* titre plus court à l'écran : texte et image équilibrés */
  .grille-404 .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; }
  @media (max-width: 860px) {
    .grille-404 { grid-template-columns: 1fr; gap: 28px; text-align: center; }
    .grille-404 .actions { justify-content: center; }
    .image-404 { max-width: 280px; max-height: none; }
  }
</style>
